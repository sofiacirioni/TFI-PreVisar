# Copiá este archivo como .env y completá los valores reales.
   # NUNCA commitear el .env real.
   
   # Clave secreta JWT. Generar en bash con: openssl rand -base64 64
   JWT_SECRET=
   
   # Duración del token en milisegundos (opcional, default 3600000)
   JWT_EXPIRATION_MS=3600000
   
   # Issuer del token (opcional, default previsar-api)
   JWT_ISSUER=previsar-api

   # Orígenes permitidos para CORS
   CORS_ALLOWED_ORIGINS=http://localhost:4200