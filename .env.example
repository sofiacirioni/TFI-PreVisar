# Copiá este archivo como .env y completá los valores.
# NUNCA commitear el .env real.
#
#   cp .env.example .env
#   docker compose up -d --build
#
# Este mismo archivo lo usan docker compose Y el desarrollo local: no hay dos
# configuraciones. Con las credenciales cargadas, todo funciona igual en ambos.
#
# Lo único obligatorio para ARRANCAR es JWT_SECRET. Las credenciales de Gemini,
# Mercado Pago y correo hacen falta para USAR esas funciones; si faltan, la app
# levanta igual y falla solo esa función al invocarla (útil para trabajar sin
# conexión o sin cuota).

# =============================================================================
# OBLIGATORIO
# =============================================================================
# Clave para firmar los JWT. Generar con:  openssl rand -base64 64
# Sin esta variable el backend NO arranca (es intencional).
JWT_SECRET=

# =============================================================================
# Puertos publicados en el host (opcional)
# =============================================================================
# Cambialos si alguno ya está ocupado en tu máquina.
FRONTEND_PORT=4200
BACKEND_PORT=8080
POSTGRES_PORT=5432

# =============================================================================
# Base de datos (opcional — los defaults sirven para desarrollo)
# =============================================================================
POSTGRES_DB=previsar
POSTGRES_USER=previsar
POSTGRES_PASSWORD=previsar_dev

# =============================================================================
# JWT (opcional)
# =============================================================================
# Duración del token en milisegundos. Default 10800000 (3 horas).
JWT_EXPIRATION_MS=10800000
JWT_ISSUER=previsar-api

# =============================================================================
# Validación visual con IA (Gemini)
# =============================================================================
# Obtener en https://aistudio.google.com/apikey
# Sin esto falla solo el análisis con IA; el resto de la app funciona igual.
GOOGLE_API_KEY=

# =============================================================================
# Mercado Pago — cobro del arancel CIEC
# =============================================================================
# Access Token de PRUEBA del vendedor de test (empieza con TEST-).
# Panel: developers -> Tus integraciones -> Credenciales de prueba.
MP_ACCESS_TOKEN=

# A dónde MP redirige el NAVEGADOR después de pagar -> FRONTEND.
MP_BACK_URL_BASE=http://localhost:4200

# A dónde MP hace la llamada server-to-server del webhook -> BACKEND, y tiene
# que ser una URL PÚBLICA. NO es la misma que MP_BACK_URL_BASE.
# En local:  ngrok http 8080  y pegar acá la URL https que devuelve (sin barra final).
# Si queda vacía, la preferencia se crea sin notification_url y el pago no se
# confirma solo (queda el botón de sincronizar como red de seguridad).
MP_WEBHOOK_URL_BASE=

# Clave del webhook: panel MP -> Tus integraciones -> Webhooks -> Configurar.
# Vacía = no se valida la firma (se procesa igual, con un WARN en el log).
MP_WEBHOOK_SECRET=

# =============================================================================
# Correo (notificaciones de pago y solicitudes de rol revisor)
# =============================================================================
# Gmail requiere una "contraseña de aplicación" (con verificación en 2 pasos
# activada): cuenta Google -> Seguridad -> Contraseñas de aplicación.
# Pegala SIN espacios.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente visible (default: el mismo MAIL_USERNAME).
MAIL_FROM=
# Casilla de la institución que recibe las solicitudes de rol revisor (ej. CIEC).
MAIL_COLEGIO=
# Kill-switch de envíos. En false no se manda ningún correo.
MAIL_HABILITADO=false

# =============================================================================
# Otros (opcional)
# =============================================================================
# Nivel de log de la aplicación: INFO o DEBUG.
LOG_LEVEL_APP=INFO
# Solo relevante si consumís la API desde un origen distinto al del frontend.
# En el stack de compose el navegador habla con nginx (mismo origen) y CORS no aplica.
CORS_ALLOWED_ORIGINS=http://localhost:4200
