# Copiá este archivo como .env y completá los valores reales.
   # NUNCA commitear el .env real.
   
   # Clave secreta JWT. Generar en bash con: openssl rand -base64 64
   JWT_SECRET=
   
   # Duración del token en milisegundos (opcional, default 3600000)
   JWT_EXPIRATION_MS=3600000
   
   # Issuer del token (opcional, default previsar-api)
   JWT_ISSUER=previsar-api

   # Orígenes permitidos para CORS
   CORS_ALLOWED_ORIGINS=http://localhost:4200

   # Clave de la API de Google Gemini (validación visual nivel 3).
   # Obtenerla en https://aistudio.google.com/apikey. La lee el SDK vía new Client() (ADR-013).
   GOOGLE_API_KEY=

   # Mercado Pago — Access Token de PRUEBA (credencial del vendedor de test).
   # Panel: developers -> Tus integraciones -> Credenciales de prueba. Empieza con TEST-...
   MP_ACCESS_TOKEN=

   # URL base a la que MP redirige el NAVEGADOR tras el pago -> FRONTEND.
   # (opcional, default http://localhost:4200)
   MP_BACK_URL_BASE=http://localhost:4200

   # URL base PUBLICA del BACKEND, a donde MP manda el webhook (server-to-server).
   # NO es la misma que MP_BACK_URL_BASE: aquella es el front (:4200), esta el back (:8080).
   # En local levantar el túnel apuntando al 8080:  ngrok http 8080
   # y pegar acá la URL https que devuelve (sin barra final).
   # Si queda vacía, la preferencia se crea SIN notification_url y el pago nunca se confirma.
   MP_WEBHOOK_URL_BASE=

   # Clave secreta del webhook: panel MP -> Tus integraciones -> Webhooks -> Configurar.
   # Si queda vacía NO se valida la firma (se procesa igual, con un WARN en el log).
   MP_WEBHOOK_SECRET=