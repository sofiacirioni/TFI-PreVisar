# Copiá este archivo como .env y completá los valores reales.
   # NUNCA commitear el .env real.
   
   # Clave secreta JWT. Generar en bash con: openssl rand -base64 64
   JWT_SECRET=
   
   # Duración del token en milisegundos (opcional, default 3600000)
   JWT_EXPIRATION_MS=3600000
   
   # Issuer del token (opcional, default previsar-api)
   JWT_ISSUER=previsar-api

   # Orígenes permitidos para CORS
   CORS_ALLOWED_ORIGINS=http://localhost:4200

   # Clave de la API de Google Gemini (validación visual nivel 3).
   # Obtenerla en https://aistudio.google.com/apikey. La lee el SDK vía new Client() (ADR-013).
   GOOGLE_API_KEY=

   # Mercado Pago — Access Token de PRUEBA (credencial del vendedor de test).
   # Panel: developers -> Tus integraciones -> Credenciales de prueba. Empieza con TEST-...
   MP_ACCESS_TOKEN=

   # URL base a la que MP redirige tras el pago (opcional, default http://localhost:4200).
   # Al probar pagos usar la URL del túnel (ngrok/cloudflared).
   MP_BACK_URL_BASE=http://localhost:4200